NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: true forces fictional demo; false shows real connection state.
# When omitted, demo starts automatically if Supabase is not configured.
DEMO_MODE=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
ONBID_API_KEY=
# Decoded public-data-portal key; server encodes it exactly once.
MOLIT_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRON_SECRET=
# Scope: confiscated assets, sale, internet bids, no private contract.
ONBID_PROPERTY_CODES=0007
ONBID_DISPOSAL_CODE=0001
ONBID_BID_DIVISION_CODE=0001
ONBID_PRIVATE_CONTRACT=N
ONBID_PAGE_SIZE=100
ONBID_MAX_PAGES=10
ONBID_REQUEST_INTERVAL_MS=1000

# NAVER Maps Application: Client ID (browser map + server geocoding)
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
# NAVER Maps Application: Client Secret (server only)
NAVER_MAP_CLIENT_SECRET=
